# Auth mode: "http" (Laravel API — staging/prod cutover) or "mock" (localStorage only).
# IndexedDB stays the working cache. mock is for machines with no backend/network.
# Phase 6: first http login uploads local files then PUT /api/v2 postcards + library.
VITE_AUTH_MODE=http

# Leave empty — requests go to /api on the Vite dev server (same origin).
# VITE_API_BASE_URL=

# npm run dev on host (Docker backend on :8000) — default, no need to set:
# VITE_DEV_API_PROXY=http://127.0.0.1:8000
#
# Frontend inside Docker — set in docker-compose:
# VITE_DEV_API_PROXY=http://php:8000
