{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./src/app/*"],
      "@cardSectionToolbar/*": ["./src/features/cardSectionToolbar/*"],
      "@db/*": ["./src/db/*"],
      "@entities/*": ["./src/entities/*"],
      "@features/*": ["./src/features/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@shared/*": ["./src/shared/*"],
      "@styles/*": ["./src/styles/*"],
      "@cardPanel/*": ["./src/features/cardPanel/*"],
      "@cardphoto/*": ["./src/features/cardphoto/*"],
      "@cardtext/*": ["./src/features/cardtext/*"],
      "@envelope/*": ["./src/features/envelope/*"],
      "@aroma/*": ["./src/features/aroma/*"],
      "@date/*": ["./src/features/date/*"],
      "@toolbar": ["./src/features/toolbar/index.ts"],
      "@toolbar/*": ["./src/features/toolbar/*"],
      "@cart/*": ["./src/features/cart/*"],
      "@layout/*": ["./src/features/layout/*"]
    }
  },
  "include": ["src"]
}
